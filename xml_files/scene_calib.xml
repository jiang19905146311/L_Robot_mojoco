<!-- 轨迹抓取 -->
<mujoco model="scene_catch">

  <compiler angle="radian" meshdir="ur5/"/>
  <!-- 加载UR5本体模型 -->
  <include file="ur5_catch.xml"/>
  
  <!-- 仿真统计参数 -->
  <statistic center="0.3 0 0.4" extent="0.8"/>
  
  <!-- 视觉渲染配置 -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>
  
  <!-- 资源定义 -->
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    
    <!-- 目标物体材质 -->
    <material name="object_mat" rgba="0.2 0.8 0.2 1"/>
    
  </asset>



  <!-- 世界结构 -->
  <worldbody>
    <!-- 光源 -->
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    
    <!-- 地面 -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="1 0.005 0.0001"/>
  
    <!-- 正上方俯视相机 -->
    <camera name="top_camera" pos="0 0 2" mode="targetbody" target="base" fovy="45"/>
  
    <!-- 侧面观测相机 -->
    <camera name="side_camera" pos="1.5 0 1.0" quat="0.5 0.5 0.5 0.5" mode="track" target="target_object"/>
  
    <!-- 待抓取的立方体 -->
    <body name="target_object" pos="0.6 0 0.03">
      <!-- 尺寸（m） -->
      <geom name="cube" type="box" size="0.03 0.03 0.03" material="object_mat" contype="1" conaffinity="1"/>
      <!-- 惯性参数 -->
      <inertial pos="0 0 0" mass="0.1" diaginertia="0.0001 0.0001 0.0001"/>
      <joint name="object_free" type="free" pos="0 0 0"/> 
    </body>
    
  </worldbody>

</mujoco>


